{
  "name": "@kubohiroya/sb3-toolchain",
  "version": "0.31.1",
  "description": "Git-friendly source management and deterministic builds for Scratch 3 and TurboWarp SB3 projects",
  "type": "module",
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "homepage": "https://kubohiroya.github.io/sb3-toolchain/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/sb3-toolchain.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/sb3-toolchain/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./web-distribution": {
      "types": "./dist/web-distribution.d.ts",
      "import": "./dist/web-distribution.js",
      "default": "./dist/web-distribution.js"
    },
    "./standard-extension-build": {
      "node": {
        "types": "./dist/standard-extension-build.d.ts",
        "import": "./dist/standard-extension-build.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sb3-toolchain": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "docs/",
    "repo-policy.json",
    "CHANGELOG.md",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --check .github docs scripts src test CHANGELOG.md eslint.config.ts package.json README.md README.ja.md repo-policy.json tsconfig.json vite.config.ts",
    "format:write": "prettier --write .github docs scripts src test CHANGELOG.md eslint.config.ts package.json README.md README.ja.md repo-policy.json tsconfig.json vite.config.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:prepare": "node --experimental-strip-types scripts/prepare-release.ts && pnpm run build",
    "release:check": "npm publish --dry-run --access public",
    "repo:check": "node --experimental-strip-types scripts/check-repo.ts",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run repo:check && pnpm run pack:check",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-manifest": "0.8.0",
    "@kubohiroya/turbowarp-plus-editor-test": "0.4.0",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "music-metadata": "12.7.0",
    "playwright-core": "1.64.1",
    "rolldown": "1.3.3",
    "semver": "7.8.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "7.8.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "sb3",
    "scratch",
    "turbowarp",
    "source-control",
    "reproducible-builds"
  ]
}
